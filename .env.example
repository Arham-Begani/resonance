# Copy to .env (repo root) and fill in. .env is git-ignored; secrets stay server-side.

# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Pin the Nemotron model id that has passed the tool-calling smoke test (see docs/ai-integration.md).
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: path to the ngspice console binary. If unset, the API uses
# .tools/ngspice-47/Spice64/bin/ngspice_con.exe (Windows, via scripts/install-ngspice.py)
# or `ngspice` on PATH (Linux/macOS, e.g. `apt-get install ngspice`).
# NGSPICE_BIN=

# Optional: where SQLite databases and audio artifacts are stored (default: .data/ in the repo).
# RESONANCE_DATA_DIR=
